PORT=3000
CORS_ORIGIN=http://localhost:5173
WEATHER_CACHE_TTL_SECONDS=1800
WEATHER_CACHE_FAILURE_TTL_SECONDS=60
QWEATHER_API_HOST=
QWEATHER_API_KEY=
# 走哪版和风接口:v1(默认)或 v7。v7 已被上游标记弃用,两份实现都保留在
# src/weather/providers/qweather/ 下,v1 出问题时改成 v7 即可回滚,不必回滚代码。
# 只接受这两个值,写错会启动失败(不会静默退回默认值)。
QWEATHER_API_VERSION=v1
CAIYUN_TOKEN=
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=30

# 地理接口(和风 GeoAPI,复用上面的 QWEATHER_API_HOST / QWEATHER_API_KEY)
# 地理数据几乎不变,TTL 比天气长得多
GEO_CACHE_TTL_SECONDS=86400
# geo 路由独立的限流额度,不与 /weather 抢同一份
GEO_THROTTLE_TTL_MS=60000
# 注意:这是 /geo/reverse、/geo/search、/geo/top 三个路由各自的额度(@nestjs/throttler
# 按 ClassName-HandlerName-limiterName-ip 生成 key,配额是 per-route 的),
# 三个路由合计是这个值的 3 倍(默认 20 → 合计 60/min/IP)
GEO_THROTTLE_LIMIT=20

# 接口路径前缀。默认空 —— 本地开发接口挂在根路径(/weather、/geo/*)。
# 子路径部署时设为 api,接口变成 /api/weather,由 nginx 把外部的
# /weather-app/api/ 转发过来。详见 docs/DEPLOYMENT.md
API_PREFIX=
