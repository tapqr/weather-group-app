# 端口配置
PORT=3000

# 彩云天气开发者 Token (在 https://platform.caiyunapp.com 申请)
# 若留空或使用默认值，后端将自动启用高保真高拟真度模拟演练引擎
CAIYUN_TOKEN=your_caiyun_token_here

# 和风天气开发者 API Key (在 https://dev.qweather.com 申请)
# 若留空或使用默认值，后端将自动启用高保真高拟真度模拟演练引擎
QWEATHER_API_KEY=your_qweather_key_here

# 和风天气专属 API 域名 (控制台项目管理中分配的域名，例如 xxx.re.qweatherapi.com；若未分配可留空，默认使用 devapi.qweather.com)
QWEATHER_API_HOST=your_host_here.re.qweatherapi.com
